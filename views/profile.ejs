<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-50">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Configurações de Perfil - JFLoader</title>

	<!-- Google Fonts: Outfit & Inter -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

	<!-- FontAwesome Icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

	<!-- Tailwind Compiled CSS -->
	<link href="/css/output.css" rel="stylesheet">
</head>

<body class="h-full font-sans text-slate-800 antialiased selection:bg-blue-500 selection:text-white bg-slate-50">

	<%
	function formatSize(bytes) {
		if (!bytes || bytes === 0) return '0 B';
		const k = 1024;
		const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
	}
	%>

	<div class="min-h-screen flex flex-col md:flex-row relative">

		<!-- MOBILE BACKDROP OVERLAY -->
		<div id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-40 hidden md:hidden transition-opacity"></div>

		<!-- SIDEBAR (RESPONSIVE DRAWER ON MOBILE, FIXED ON DESKTOP) -->
		<aside id="mobileSidebar" class="fixed inset-y-0 left-0 w-72 bg-white z-50 p-6 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out md:static md:w-64 md:z-auto border-r border-slate-200/80 shrink-0">
			<div>
				<!-- Logo & Mobile Close Button -->
				<div class="flex items-center justify-between mb-8">
					<a href="/home/<%= user.username %>" class="flex items-center gap-2.5 group">
						<div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
							<i class="fa-solid fa-cloud text-lg"></i>
						</div>
						<div>
							<div class="flex items-center gap-1.5">
								<span class="text-xl font-bold font-heading text-slate-900 tracking-tight">JFLoader</span>
								<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700 uppercase">CLOUD</span>
							</div>
							<span class="block text-[10px] text-slate-400 font-medium -mt-0.5">Armazenamento Rápido</span>
						</div>
					</a>

					<!-- Mobile Close Drawer Button -->
					<button id="closeMobileSidebarBtn" class="md:hidden text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer" title="Fechar Menu">
						<i class="fa-solid fa-xmark text-lg"></i>
					</button>
				</div>

				<!-- Primary Action Button: + Novo Envio -->
				<a href="/home/<%= user.username %>" class="w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md shadow-blue-500/25 hover:shadow-blue-500/35 transition-all flex items-center justify-center gap-2 mb-8 cursor-pointer">
					<i class="fa-solid fa-plus text-sm"></i>
					<span>Novo Arquivo</span>
				</a>

				<!-- Navigation Section -->
				<div class="space-y-6">
					<div>
						<span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-3 px-3">NAVEGAÇÃO</span>
						<nav class="space-y-1">
							<!-- Home (Root directory) -->
							<a href="/home/<%= user.username %>" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
								<i class="fa-solid fa-house text-base w-5 text-center text-slate-400"></i>
								<span>Home</span>
							</a>

							<!-- Fotos & Imagens -->
							<a href="/home/<%= user.username %>" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
								<i class="fa-regular fa-image text-base w-5 text-center text-slate-400"></i>
								<span>Fotos & Imagens</span>
							</a>

							<!-- Documentos -->
							<a href="/home/<%= user.username %>" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
								<i class="fa-regular fa-file-lines text-base w-5 text-center text-slate-400"></i>
								<span>Documentos</span>
							</a>

							<!-- Vídeos -->
							<a href="/home/<%= user.username %>" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
								<i class="fa-solid fa-film text-base w-5 text-center text-slate-400"></i>
								<span>Vídeos</span>
							</a>

							<!-- Áudios -->
							<a href="/home/<%= user.username %>" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
								<i class="fa-solid fa-headphones text-base w-5 text-center text-slate-400"></i>
								<span>Áudios</span>
							</a>

							<!-- Outros -->
							<a href="/home/<%= user.username %>" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
								<i class="fa-solid fa-boxes-stacked text-base w-5 text-center text-slate-400"></i>
								<span>Outros</span>
							</a>
						</nav>
					</div>

					<!-- Account Settings Section (Active) -->
					<div>
						<span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-3 px-3">CONTA</span>
						<a href="/profile" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold bg-blue-50 text-blue-600 transition-colors">
							<i class="fa-solid fa-user text-base w-5 text-center"></i>
							<span>Perfil e Conta</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Sidebar Bottom -->
			<div class="mt-8 pt-6 border-t border-slate-100 space-y-6">
				<!-- Storage Meter Box -->
				<div class="bg-blue-50/70 border border-blue-100 rounded-2xl p-4">
					<div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-2">
						<span class="flex items-center gap-1.5">
							<i class="fa-solid fa-cloud text-blue-600 text-xs"></i>
							Armazenamento
						</span>
						<span class="text-blue-600 font-bold text-xs">24%</span>
					</div>
					<div class="w-full bg-blue-200/60 h-2 rounded-full overflow-hidden mb-2">
						<div class="bg-blue-600 h-full w-1/4 rounded-full"></div>
					</div>
					<div class="flex items-center justify-between text-[11px]">
						<span class="text-slate-500">2.4 GB de 10 GB</span>
						<a href="#" class="text-blue-600 font-bold hover:underline">Upgrade</a>
					</div>
				</div>

				<!-- Logout -->
				<div class="space-y-1">
					<a href="/logout" class="flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-rose-50 hover:text-rose-600 transition-colors">
						<i class="fa-solid fa-right-from-bracket text-slate-400"></i>
						<span>Sair da conta</span>
					</a>
				</div>
			</div>
		</aside>

		<!-- MAIN CONTENT AREA -->
		<div class="flex-grow flex flex-col min-w-0">
			
			<!-- TOP HEADER BAR -->
			<header class="bg-white border-b border-slate-200/80 px-4 sm:px-6 py-4 flex items-center justify-between gap-3 sticky top-0 z-30">
				
				<!-- Mobile Toggle & Breadcrumbs -->
				<div class="flex items-center gap-3">
					<button id="openMobileSidebarBtn" class="md:hidden p-2 rounded-xl border border-slate-200 bg-white text-slate-700 hover:text-blue-600 hover:border-blue-300 transition-colors shrink-0 cursor-pointer" title="Abrir Menu">
						<i class="fa-solid fa-bars text-base"></i>
					</button>

					<nav class="flex items-center gap-2 text-xs text-slate-400 font-medium">
						<a href="/home/<%= user.username %>" class="hover:text-blue-600 transition-colors">Início</a>
						<span>/</span>
						<span class="text-slate-600 font-semibold">Configurações de Perfil</span>
					</nav>
				</div>

				<!-- Right Controls -->
				<div class="flex items-center gap-3">
					<div class="flex items-center gap-1 bg-slate-100 px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 border border-slate-200">
						<i class="fa-solid fa-globe text-slate-400 text-xs"></i>
						<span>PT-BR</span>
					</div>

					<button class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-amber-500 hover:bg-slate-200 transition-colors" title="Modo Claro">
						<i class="fa-solid fa-sun text-sm"></i>
					</button>

					<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200">
						<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
						Online
					</span>
				</div>
			</header>

			<!-- DASHBOARD CONTENT BODY -->
			<main class="p-4 sm:p-8 flex-grow">
				<!-- Title & Help Button -->
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
					<div>
						<h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-slate-900 tracking-tight">
							Configurações de Perfil
						</h1>
						<p class="text-xs sm:text-sm text-slate-500 mt-1">Gerencie seus dados pessoais, credenciais de segurança e preferências da nuvem.</p>
					</div>

					<button class="px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 shadow-xs transition-colors self-start sm:self-auto">
						<i class="fa-regular fa-circle-question text-slate-400"></i>
						<span>Central de Ajuda</span>
					</button>
				</div>

				<!-- Success Alert -->
				<% if (locals.success) { %>
					<div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-2xl mb-6 text-emerald-800 text-xs sm:text-sm shadow-xs flex items-center gap-3">
						<i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
						<span><%= locals.success %></span>
					</div>
				<% } %>

				<!-- Error Alert -->
				<% if (locals.errors && locals.errors.length > 0) { %>
					<div class="bg-rose-50 border-l-4 border-rose-500 p-4 rounded-2xl mb-6 text-rose-800 text-xs sm:text-sm shadow-xs">
						<div class="flex items-center gap-2 font-semibold mb-1">
							<i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
							<span>Atenção aos seguintes problemas:</span>
						</div>
						<ul class="list-disc list-inside space-y-1 text-rose-600">
							<% locals.errors.forEach(error => { %>
								<li><%= error.msg %></li>
							<% }) %>
						</ul>
					</div>
				<% } %>

				<!-- MAIN TWO-COLUMN GRID -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
					
					<!-- LEFT COLUMN: Profile Summary Card & Account Status -->
					<div class="lg:col-span-4 space-y-6">
						
						<!-- Profile Summary Card -->
						<div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden text-center relative">
							<!-- Gradient Banner Header -->
							<div class="h-28 bg-gradient-to-r from-blue-500 via-blue-600 to-indigo-600 relative"></div>

							<!-- Profile Avatar with Upload Camera Button -->
							<div class="relative -mt-14 inline-block mx-auto mb-4">
								<img id="avatarPreview" src="<%= user.profilePicture || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
									class="w-28 h-28 rounded-full object-cover border-4 border-white shadow-md bg-white">
								
								<!-- Camera Button overlay that triggers file input in form -->
								<button type="button" onclick="document.getElementById('profilePictureInput').click();"
									class="absolute bottom-1 right-1 w-9 h-9 rounded-full bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center shadow-md transition-transform hover:scale-110 cursor-pointer"
									title="Alterar Foto de Perfil">
									<i class="fa-solid fa-camera text-sm"></i>
								</button>
							</div>

							<!-- User Details -->
							<div class="px-6 pb-6">
								<h2 class="text-xl font-bold font-heading text-slate-900">
									<%= user.firstName %> <%= user.lastName %>
								</h2>
								<p class="text-xs text-slate-400 font-medium mb-4">@<%= user.username %></p>

								<!-- User Badges -->
								<div class="flex items-center justify-center gap-2 mb-6">
									<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
										<i class="fa-solid fa-award text-amber-500"></i>
										Plano Pro
									</span>
									<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
										<i class="fa-solid fa-shield-halved text-blue-600"></i>
										Odin Member
									</span>
								</div>

								<!-- Storage Usage Box -->
								<div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 text-left">
									<div class="flex items-center justify-between text-xs font-bold text-slate-700 mb-2">
										<span>Espaço em Nuvem</span>
										<span class="text-blue-600"><%= formatSize(stats.totalSizeBytes) %> / 10 GB</span>
									</div>
									<div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden mb-4">
										<div class="bg-blue-600 h-full rounded-full" style="width: <%= Math.min(100, Math.max(5, Math.round((stats.totalSizeBytes / (10 * 1024 * 1024 * 1024)) * 100))) %>%"></div>
									</div>

									<!-- Breakdown Stats -->
									<div class="grid grid-cols-3 gap-2 text-center text-[11px]">
										<div class="bg-white p-2 rounded-xl border border-slate-100">
											<span class="block font-bold text-slate-800"><%= formatSize(stats.videosSizeBytes) %></span>
											<span class="text-slate-400">Vídeos</span>
										</div>
										<div class="bg-white p-2 rounded-xl border border-slate-100">
											<span class="block font-bold text-slate-800"><%= formatSize(stats.imagesSizeBytes) %></span>
											<span class="text-slate-400">Fotos</span>
										</div>
										<div class="bg-white p-2 rounded-xl border border-slate-100">
											<span class="block font-bold text-slate-800"><%= formatSize(stats.othersSizeBytes) %></span>
											<span class="text-slate-400">Outros</span>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Status da Conta Card -->
						<div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs flex items-start gap-4">
							<div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
								<i class="fa-solid fa-shield-check text-lg"></i>
							</div>
							<div>
								<h3 class="text-sm font-bold text-slate-900">Status da Conta: Seguro</h3>
								<p class="text-xs text-slate-500 mt-1 leading-relaxed">Sua autenticação e armazenamento estão protegidos com criptografia. Mantenha seus dados sempre atualizados.</p>
							</div>
						</div>
					</div>

					<!-- RIGHT COLUMN: Personal Info & Password Settings -->
					<div class="lg:col-span-8 space-y-6">
						
						<!-- CARD 1: Informações Pessoais -->
						<div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
							<div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
								<div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
									<i class="fa-regular fa-user text-lg"></i>
								</div>
								<div>
									<h2 class="text-lg font-bold font-heading text-slate-900">Informações Pessoais</h2>
									<p class="text-xs text-slate-500">Atualize suas informações cadastrais e sua foto de perfil.</p>
								</div>
							</div>

							<!-- Form Update Profile -->
							<form action="/profile/update" method="POST" enctype="multipart/form-data" class="space-y-5">
								<!-- Hidden Profile Picture File Input (Triggered by camera button or manual selection) -->
								<div>
									<label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Foto de Perfil (Envio para a Home do Usuário)</label>
									<input type="file" id="profilePictureInput" name="profilePicture" accept="image/*" onchange="previewImage(event)"
										class="w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-colors">
								</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									<!-- First Name -->
									<div>
										<label for="firstName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Nome</label>
										<input type="text" id="firstName" name="firstName" value="<%= user.firstName %>" required
											class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-sm font-medium text-slate-800 outline-none transition-all">
									</div>

									<!-- Last Name -->
									<div>
										<label for="lastName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Sobrenome</label>
										<input type="text" id="lastName" name="lastName" value="<%= user.lastName %>" required
											class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-sm font-medium text-slate-800 outline-none transition-all">
									</div>
								</div>

								<!-- Username -->
								<div>
									<label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Nome de Usuário</label>
									<div class="relative">
										<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
											<i class="fa-solid fa-at text-sm"></i>
										</div>
										<input type="text" id="username" name="username" value="<%= user.username %>" required
											class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-sm font-medium text-slate-800 outline-none transition-all">
									</div>
								</div>

								<!-- Submit Button -->
								<div class="flex justify-end pt-2">
									<button type="submit"
										class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-500/20 transition-all flex items-center gap-2 cursor-pointer">
										<i class="fa-solid fa-check text-sm"></i>
										<span>Salvar Alterações</span>
									</button>
								</div>
							</form>
						</div>

						<!-- CARD 2: Segurança e Senha -->
						<div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
							<div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
								<div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
									<i class="fa-solid fa-lock text-lg"></i>
								</div>
								<div>
									<h2 class="text-lg font-bold font-heading text-slate-900">Segurança e Senha</h2>
									<p class="text-xs text-slate-500">Mantenha sua senha forte com pelo menos 6 caracteres.</p>
								</div>
							</div>

							<!-- Form Change Password -->
							<form action="/profile/change-password" method="POST" class="space-y-4">
								<!-- Current Password -->
								<div>
									<label for="currentPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Senha Atual</label>
									<input type="password" id="currentPassword" name="currentPassword" placeholder="Digite sua senha atual" required
										class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-sm outline-none transition-all">
								</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									<!-- New Password -->
									<div>
										<label for="newPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Nova Senha</label>
										<input type="password" id="newPassword" name="newPassword" placeholder="Mínimo de 6 caracteres" required
											class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-sm outline-none transition-all">
									</div>

									<!-- Confirm New Password -->
									<div>
										<label for="confirmNewPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Confirmar Nova Senha</label>
										<input type="password" id="confirmNewPassword" name="confirmNewPassword" placeholder="Repita a nova senha" required
											class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-sm outline-none transition-all">
									</div>
								</div>

								<div class="flex justify-end pt-2">
									<button type="submit"
										class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-colors cursor-pointer">
										Atualizar Senha
									</button>
								</div>
							</form>
						</div>

						<!-- CARD 3: Preferências da Conta -->
						<div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
							<div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
								<div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
									<i class="fa-solid fa-sliders text-lg"></i>
								</div>
								<div>
									<h2 class="text-lg font-bold font-heading text-slate-900">Preferências da Conta</h2>
									<p class="text-xs text-slate-500">Configure idioma padrão e exibição visual.</p>
								</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Idioma Padrão</label>
									<select class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-xs font-semibold text-slate-800 outline-none">
										<option selected>Português (Brasil)</option>
										<option>English (US)</option>
										<option>Español</option>
									</select>
								</div>

								<div>
									<label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Tema de Interface</label>
