<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>HOME | <%= user.username %>
	</title>
</head>

<body>
	<p>Welcome, <%= user.username %>
	</p>

	<a href="/logout">Logout</a>

	<p>Current folder: <%= currentFolder.name %>
	</p>

	<div>
		<dialog id="createFolderDialog">
			<summary>Create new folder</summary>
			<form action="<%= '/home/' + user.username + '/folders/' + currentFolder.id + '/createFolder' %>"
				method="post">
				<input type="text" name="folderName" placeholder="Folder name" required>
				<button type="submit">Create folder</button>
			</form>
		</dialog>
		<dialog id="uploadFileDialog">
			<summary>Add a new file</summary>
			<form action="<%= '/' + user.username + '/folders/' + currentFolder.id + '/uploadFile' %>" method="post"
				enctype="multipart/form-data">
				<input type="text" name="fileName" placeholder="File name" required>
				<input type="file" name="file" required>
				<button type="submit">Add file</button>
			</form>
		</dialog>
	</div>

	<div>
		<button id="openCreateFolderDialog">New folder</button>
		<button id="openUploadFileDialog">Upload a file</button>
	</div>

	<dialog id="confirmDeleteDialog">
		<p>Are you sure you want to delete this folder?</p>
		<a id="confirmDeleteLink" href="#">
			Delete
		</a>
		<button id="closeConfirmDeleteDialog">Cancel</button>
	</dialog>

	<p>Your folders:</p>
	<ul>
		<% folderChildren.forEach(folder=> { %>
			<li>
				<a href="<%= '/home/' + user.username + '/folders/' + folder.id %>">
					<%= folder.name %>
				</a>
				<button onclick="openConfirmDeleteDialog('<%= folder.id %>', '<%= folder.name %>')">Delete</button>
			</li>
			<% }) %>
	</ul>
	<p>Your files:</p>
	<ul>
		<% files.forEach(file=> { %>
			<li>
				<%= file.name %>
			</li>
			<% }) %>
	</ul>

	<script>
		const createFolderDialog = document.getElementById('createFolderDialog');
		const uploadFileDialog = document.getElementById('uploadFileDialog');
		const openCreateFolderDialog = document.getElementById('openCreateFolderDialog');
		const openUploadFileDialog = document.getElementById('openUploadFileDialog');
		openCreateFolderDialog.addEventListener('click', () => {
			createFolderDialog.showModal();
		});
		openUploadFileDialog.addEventListener('click', () => {
			uploadFileDialog.showModal();
		});

		const confirmDeleteDialog = document.getElementById('confirmDeleteDialog');
		const closeConfirmDeleteDialog = document.getElementById('closeConfirmDeleteDialog');
		const openConfirmDeleteDialog = (folderId, folderName) => {
			confirmDeleteDialog.showModal();
			confirmDeleteDialog.querySelector('a').href = `/home/<%= user.username %>/folders/${folderId}/delete`;
		};
		closeConfirmDeleteDialog.addEventListener('click', () => {
			confirmDeleteDialog.close();
		});
	</script>
</body>

</html>