<header class="sticky top-0 z-50 border-b border-slate-200 bg-[#f4f4f4]">
	<div class="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
		<div class="flex h-20 items-center justify-between gap-4">
			<div class="flex shrink-0 items-center gap-3">
				<a href="/" class="flex items-center gap-3">
					<div class="flex h-9 w-9 items-center justify-center rounded-md bg-[#1f2937] text-white shadow-sm">
						<i class="fa-solid fa-cloud text-lg"></i>
					</div>
					<span class="text-[2rem] font-bold tracking-tight text-slate-900">JFLoader</span>
				</a>
			</div>

			<nav class="hidden items-center gap-7 text-[15px] font-medium text-slate-700 md:flex">
				<a href="/" class="transition-colors hover:text-slate-900">Home</a>
				<a href="#about" class="transition-colors hover:text-slate-900">Sobre</a>
				<a href="#features" class="transition-colors hover:text-slate-900">Recursos</a>
				<a href="#tech" class="transition-colors hover:text-slate-900">Tecnologia</a>
				<a href="#how-it-works" class="transition-colors hover:text-slate-900">Como funciona</a>
			</nav>

			<div class="flex items-center gap-3 shrink-0">
				<% if (locals.user) { %>
					<a href="/home/<%= locals.user.username %>" class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100">
						<img src="<%= locals.user.profilePicture || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" class="h-8 w-8 rounded-full object-cover" alt="Avatar">
						<span class="hidden sm:inline"><%= locals.user.username %></span>
					</a>
					<a href="/logout" class="hidden rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 sm:inline-flex">Sair</a>
				<% } else { %>
					<button type="button" class="hidden h-11 w-11 items-center justify-center rounded-full bg-[#2a2a2a] text-lg text-white transition hover:bg-[#1f1f1f] sm:flex" aria-label="Idioma">
						<i class="fa-solid fa-globe"></i>
					</button>
					<div class="hidden items-center gap-3 sm:flex">
						<a href="/login" class="inline-flex items-center justify-center rounded-full bg-[#2a2a2a] px-6 py-3 text-[1.05rem] font-semibold text-white shadow-sm transition hover:bg-[#1f1f1f]">
							Login
						</a>
						<a href="/signup" class="inline-flex items-center justify-center rounded-full bg-[#1856f3] px-6 py-3 text-[1.05rem] font-semibold text-white shadow-sm transition hover:bg-[#4b97f6]">
							Cadastrar
						</a>
					</div>
				<% } %>

				<details class="relative md:hidden">
					<summary class="list-none cursor-pointer rounded-full bg-[#2a2a2a] p-3 text-white shadow-sm transition hover:bg-[#1f1f1f]">
						<i class="fa-solid fa-bars text-lg"></i>
					</summary>
					<nav class="absolute right-0 top-[calc(100%+0.75rem)] w-56 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl">
						<a href="/" class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900">Home</a>
						<a href="#about" class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900">Sobre</a>
						<a href="#features" class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900">Recursos</a>
						<a href="#tech" class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900">Tecnologia</a>
						<a href="#how-it-works" class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900">Como funciona</a>
						<div class="mt-2 border-t border-slate-200 pt-2">
							<a href="/login" class="block rounded-xl bg-[#2a2a2a] px-3 py-2 text-center text-sm font-semibold text-white transition hover:bg-[#1f1f1f]">Login</a>
							<a href="/signup" class="mt-2 block rounded-xl bg-[#2a2a2a] px-3 py-2 text-center text-sm font-semibold text-white transition hover:bg-[#1f1f1f]">Cadastrar</a>
						</div>
					</nav>
				</details>
			</div>
		</div>
	</div>
</header>